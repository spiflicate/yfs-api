{
   "extends": "./tsconfig.json",
   "compilerOptions": {
      // Output configuration
      "outDir": "./dist",
      "rootDir": "./src",
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "target": "ES2022",
      "lib": ["ES2022"],
      // Build-specific overrides
      "noEmit": false,
      "types": ["node"],
      "verbatimModuleSyntax": true,
      // Additional strictness for library code
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      // Ensure compatibility
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "incremental": false,
      // Remove internal paths from declarations
      "declarationDir": "./dist",
      "stripInternal": true
   },
   "include": ["src/**/*"],
   "exclude": [
      "node_modules",
      "dist",
      "**/*.test.ts",
      "**/*.spec.ts",
      "src/resources/builders/transaction-builder.ts",
      "tests",
      "examples",
      "scripts",
      "coverage"
   ]
}
